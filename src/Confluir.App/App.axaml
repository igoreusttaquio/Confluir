<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Confluir.App.App"
             Name="Confluir"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="False"
                             PreferUserAccentColor="False"
                             CustomAccentColor="#2F5BEA" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://Confluir/Styles/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Light" Source="avares://Confluir/Themes/Light.axaml" />
        <ResourceInclude x:Key="Dark" Source="avares://Confluir/Themes/Dark.axaml" />
      </ResourceDictionary.ThemeDictionaries>

      <!-- Marca: ícone, splash, ilustrações -->
      <SolidColorBrush x:Key="Brand.Blue" Color="#3D6BFF" />
      <SolidColorBrush x:Key="Brand.Coral" Color="#FF7A66" />
      <SolidColorBrush x:Key="Brand.Teal" Color="#14C7B4" />
      <SolidColorBrush x:Key="Brand.Amber" Color="#FFB938" />

      <!-- Cantos: controles (botões, campos, combos) e sobreposições (menus, flyouts, dicas) -->
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <!-- Painéis (lista, leitura, páginas) como cartões -->
      <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>

      <!-- Altura comum dos cabeçalhos de painel (lista e leitura), para as bordas ficarem alinhadas -->
      <x:Double x:Key="PaneHeaderHeight">64</x:Double>

      <!-- Tamanhos de fonte da lista (Aparência → Tamanho do texto da lista; ajustados pelo ThemeService) -->
      <x:Double x:Key="ListFromFontSize">14</x:Double>
      <x:Double x:Key="ListSubjectFontSize">13</x:Double>
      <x:Double x:Key="ListPreviewFontSize">13</x:Double>
      <x:Double x:Key="ListMetaFontSize">12</x:Double>
      <x:Double x:Key="SidebarItemFontSize">14</x:Double>
      <x:Double x:Key="SidebarAccountFontSize">13</x:Double>
      <x:Double x:Key="SidebarCaptionFontSize">12</x:Double>
      <x:Double x:Key="SidebarBadgeFontSize">11</x:Double>

      <!-- Texto sobre as cores de conta (avatares), que são as mesmas nos dois temas -->
      <SolidColorBrush x:Key="OnAccountColor" Color="#0B1020" />

      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Confluir/Styles/Logo.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
