<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Confluir.App.ViewModels">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Item da lista de mensagens: hover em SurfaceAlt, seleção em Accent a 12%. -->
      <ControlTheme x:Key="MessageItemTheme" TargetType="ListBoxItem" x:DataType="vm:MessageListRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </ControlTheme>

      <!-- Item da barra lateral: cantos arredondados, seleção em Accent a 12%.
           Cabeçalhos de conta não recebem foco nem seleção; o clique é tratado pelo botão de recolher. -->
      <ControlTheme x:Key="SidebarItemTheme" TargetType="ListBoxItem" x:DataType="vm:SidebarNode">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="{Binding IsSelectable}" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource Border}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
        </Style>
      </ControlTheme>

      <!-- Divisor de colunas: linha de 1px com área de arraste mais larga. -->
      <ControlTheme x:Key="ColumnSplitterTheme" TargetType="GridSplitter">
        <Setter Property="Width" Value="7" />
        <Setter Property="Margin" Value="-3,0" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <Border Width="1" Background="{DynamicResource Border}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Background}" />
  </Style>

  <!-- Tipografia básica com tokens de tema -->
  <Style Selector="TextBlock.secondary, SelectableTextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- Contador de não lidos -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontSize" Value="{DynamicResource SidebarBadgeFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Botão de ícone das barras de ferramentas -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.icon LucideIcon">
    <Setter Property="Size" Value="18" />
    <Setter Property="StrokeWidth" Value="1.75" />
  </Style>
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Botão de destaque com os tokens Accent/OnAccent -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.accent.iconOnly">
    <Setter Property="Padding" Value="9" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.accent:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- Botão de ação destrutiva -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Background}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Background}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Amostra de cor selecionável: anel em TextPrimary quando selecionada -->
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ring" Padding="2" CornerRadius="999" BorderThickness="2" BorderBrush="Transparent"
                Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:pointerover /template/ Border#ring">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected /template/ Border#ring">
    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Indicador de carregamento girando -->
  <Style Selector="LucideIcon.spin">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0.0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360.0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Transição suave de cores ao trocar de tema -->
  <Style Selector="Border.panel">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
