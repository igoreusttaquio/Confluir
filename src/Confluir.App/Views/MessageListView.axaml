<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Confluir.App.Localization"
             xmlns:vm="using:Confluir.App.ViewModels"
             xmlns:conv="using:Confluir.App.Converters"
             x:Class="Confluir.App.Views.MessageListView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.from">
      <Setter Property="FontSize" Value="{DynamicResource ListFromFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.subject">
      <Setter Property="FontSize" Value="{DynamicResource ListSubjectFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.preview">
      <Setter Property="FontSize" Value="{DynamicResource ListPreviewFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector=":is(Control).unread TextBlock.from, :is(Control).unread TextBlock.subject">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(Control).unread TextBlock.date">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Modo compacto: uma linha por mensagem (remetente, assunto, ícones e data) -->
    <Style Selector="ListBox:not(.compact) Grid.compactRow">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.compact StackPanel.message">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.compact Border.strip">
      <Setter Property="Margin" Value="8,5,0,5" />
    </Style>
    <Style Selector="ListBox.compact TextBlock.groupHeader">
      <Setter Property="Margin" Value="20,8,12,2" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Grid.compactRow TextBlock.from, Grid.compactRow TextBlock.subject">
      <Setter Property="FontSize" Value="{DynamicResource ListSubjectFontSize}" />
    </Style>
    <!-- Filtros: pílulas pequenas; a escolhida fica na cor de destaque -->
    <Style Selector="RadioButton.chip">
      <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.chip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.date">
      <Setter Property="FontSize" Value="{DynamicResource ListMetaFontSize}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="panel" Background="{DynamicResource Surface}">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="{StaticResource PaneHeaderHeight}" Padding="18,0,12,0"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ListTitle}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ListSubtitle}" Classes="caption" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:Tr Action_Sync}" AutomationProperties.Name="{l:Tr Action_Sync}">
              <LucideIcon Kind="RefreshCw" />
            </Button>
            <Button Classes="accent iconOnly" Command="{Binding NewMessageCommand}" ToolTip.Tip="{l:Tr Action_NewMessage}" AutomationProperties.Name="{l:Tr Action_NewMessage}">
              <LucideIcon Kind="SquarePen" Size="18" Foreground="{DynamicResource OnAccent}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Filtros rápidos -->
      <Border DockPanel.Dock="Top" Padding="14,8,12,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
              IsVisible="{Binding HasAccounts}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton Classes="chip" GroupName="listFilter" IsChecked="{Binding IsFilterAll}" Content="{l:Tr Filter_All}" />
          <RadioButton Classes="chip" GroupName="listFilter" IsChecked="{Binding IsFilterUnread}" Content="{l:Tr Filter_Unread}" />
          <!-- Só ícone: cabe mesmo com a lista estreita -->
          <RadioButton Classes="chip" GroupName="listFilter" IsChecked="{Binding IsFilterFlagged}"
                       ToolTip.Tip="{l:Tr Filter_Flagged}" AutomationProperties.Name="{l:Tr Filter_Flagged}">
            <LucideIcon Kind="Flag" Size="13" />
          </RadioButton>
          <RadioButton Classes="chip" GroupName="listFilter" IsChecked="{Binding IsFilterAttachments}"
                       ToolTip.Tip="{l:Tr Filter_Attachments}" AutomationProperties.Name="{l:Tr Filter_Attachments}">
            <LucideIcon Kind="Paperclip" Size="13" />
          </RadioButton>
        </StackPanel>
      </Border>
      <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsListLoading}"
                   MinHeight="2" Height="2" Margin="0,-2,0,0" />

      <Grid>
        <TextBlock Text="{Binding ListEmptyText}" Classes="secondary"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsListEmpty}" />

        <!-- Sem contas -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24"
                    IsVisible="{Binding ShowNoAccounts}" MaxWidth="300">
          <LucideIcon Kind="MailPlus" Size="40" StrokeWidth="1.5" Foreground="{DynamicResource Accent}" />
          <TextBlock Text="{l:Tr NoAccounts_Title}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
          <TextBlock Text="{l:Tr NoAccounts_Hint}" Classes="secondary" TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Button Classes="accent" HorizontalAlignment="Center" Margin="0,6,0,0" Command="{Binding AddAccountCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <LucideIcon Kind="UserPlus" Size="16" Foreground="{DynamicResource OnAccent}" />
              <TextBlock Text="{l:Tr Account_Add}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Erro ao carregar -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24"
                    IsVisible="{Binding HasListError}" MaxWidth="320">
          <LucideIcon Kind="CircleAlert" Size="32" StrokeWidth="1.5" Foreground="{DynamicResource Danger}" />
          <TextBlock Text="{l:Tr List_Error}" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Text="{Binding ListError}" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
          <Button HorizontalAlignment="Center" Command="{Binding RetryListCommand}" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <LucideIcon Kind="RefreshCw" Size="14" />
              <TextBlock Text="{l:Tr Action_Retry}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- ListBox usa VirtualizingStackPanel: só os itens visíveis têm containers. -->
        <ListBox x:Name="Messages" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}"
                 Classes.compact="{Binding Appearance.CompactMode}"
                 ItemContainerTheme="{StaticResource MessageItemTheme}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:DateHeaderRow">
              <TextBlock Classes="groupHeader" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondary}" Margin="20,14,12,4" />
            </DataTemplate>

            <DataTemplate DataType="vm:MessageRow">
              <Grid ColumnDefinitions="Auto,*">
                <!-- Faixa com a cor da conta -->
                <Border Classes="strip" Width="3" CornerRadius="2" Margin="8,8,0,8"
                        Background="{Binding Account.ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                        ToolTip.Tip="{Binding Account.DisplayName}" />
                <StackPanel Grid.Column="1" Classes="message" Classes.unread="{Binding IsUnread}"
                            Margin="10,9,12,9" Spacing="2">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{DynamicResource Accent}" IsVisible="{Binding IsUnread}" />
                    <TextBlock Grid.Column="1" Classes="from" Text="{Binding From}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="caption date" Text="{Binding DateText}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="subject" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                      <LucideIcon Kind="Paperclip" Size="13" Foreground="{DynamicResource TextSecondary}"
                                  IsVisible="{Binding HasAttachments}" />
                      <LucideIcon Kind="Flag" Size="13" Foreground="{DynamicResource Warning}"
                                  IsVisible="{Binding IsFlagged}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="preview" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="1" Classes="compactRow" Classes.unread="{Binding IsUnread}" Margin="10,6,12,6"
                      ColumnDefinitions="Auto,0.38*,0.62*,Auto,Auto">
                  <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                           Fill="{DynamicResource Accent}" IsVisible="{Binding IsUnread}" />
                  <TextBlock Grid.Column="1" Classes="from" Text="{Binding From}" TextTrimming="CharacterEllipsis"
                             Margin="0,0,10,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="subject" Text="{Binding Subject}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                    <LucideIcon Kind="Paperclip" Size="12" Foreground="{DynamicResource TextSecondary}"
                                IsVisible="{Binding HasAttachments}" />
                    <LucideIcon Kind="Flag" Size="12" Foreground="{DynamicResource Warning}"
                                IsVisible="{Binding IsFlagged}" />
                  </StackPanel>
                  <TextBlock Grid.Column="4" Classes="caption date" Text="{Binding DateText}"
                             Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
