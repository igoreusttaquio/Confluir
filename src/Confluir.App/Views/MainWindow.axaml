<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Confluir.App.Localization"
        xmlns:vm="using:Confluir.App.ViewModels"
        xmlns:views="using:Confluir.App.Views"
        x:Class="Confluir.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{l:Tr AppTitle}"
        Icon="/Assets/confluir.ico"
        Width="1320" Height="820" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding GoBackCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Caixa de email (lista + leitura): sai deslizando para a esquerda quando uma página é aberta. -->
    <Style Selector="Grid#Columns > :is(Control).home">
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid#Columns.navigated > :is(Control).home">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateX(-32px)" />
    </Style>

    <!-- Host de páginas: entra pela direita. -->
    <Style Selector="Grid#Columns > Border#PageHost">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateX(48px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- O host de páginas já é um cartão: painéis dentro dele (ex.: mensagem maximizada) não repetem margem nem borda. -->
    <Style Selector="Border#PageHost Border.panel">
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Grid#Columns.navigated > Border#PageHost">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
    </Style>
  </Window.Styles>

  <!-- A barra lateral fica sempre visível; a área de conteúdo alterna entre a caixa de email e as páginas. -->
  <LayoutTransformControl x:Name="ScaleHost">
  <Grid x:Name="Columns" Classes.navigated="{Binding !Navigation.IsAtRoot}" ClipToBounds="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" MinWidth="200" MaxWidth="420" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="400" MinWidth="300" MaxWidth="720" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <views:SidebarView Grid.Column="0" ZIndex="2" />
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Theme="{StaticResource ColumnSplitterTheme}" ZIndex="2" />
    <views:MessageListView Grid.Column="2" Classes="home" />
    <GridSplitter x:Name="ReadingSplitter" Grid.Column="3" Classes="home" Theme="{StaticResource ColumnSplitterTheme}" />
    <views:ReadingPaneView x:Name="ReadingPane" Grid.Column="4" Classes="home" />

    <!-- Páginas navegadas (adicionar conta, configurações…) sobre a área de conteúdo -->
    <Border x:Name="PageHost" Grid.Column="2" Grid.ColumnSpan="3" ZIndex="1" Background="{DynamicResource Background}"
            Padding="0,8,8,8">
      <Border CornerRadius="{DynamicResource PanelCornerRadius}" ClipToBounds="True" BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <TransitioningContentControl Content="{Binding Navigation.DisplayedPage}">
        <TransitioningContentControl.PageTransition>
          <CompositePageTransition>
            <CrossFade Duration="0:0:0.18" />
            <PageSlide Duration="0:0:0.22" Orientation="Horizontal" SlideInEasing="CubicEaseOut" SlideOutEasing="CubicEaseIn" />
          </CompositePageTransition>
        </TransitioningContentControl.PageTransition>
        <TransitioningContentControl.DataTemplates>
          <DataTemplate DataType="vm:AccountEditorViewModel">
            <views:AccountEditorView />
          </DataTemplate>
          <DataTemplate DataType="vm:MessagePageViewModel">
            <views:MessagePageView />
          </DataTemplate>
          <DataTemplate DataType="vm:RuleEditorViewModel">
            <views:RuleEditorView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
          <DataTemplate DataType="vm:ComposeViewModel">
            <views:ComposeView />
          </DataTemplate>
        </TransitioningContentControl.DataTemplates>
      </TransitioningContentControl>
      </Border>
    </Border>

    <!-- Aviso temporário (ex.: "Mensagem enviada"). Fica sobre a lista: o painel de leitura é um WebView nativo,
         que ficaria por cima do aviso. -->
    <Border Grid.Column="2" ZIndex="3" IsVisible="{Binding HasStatus}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
            Background="{DynamicResource TextPrimary}" CornerRadius="10" Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <LucideIcon Kind="CircleCheck" Size="16" Foreground="{DynamicResource Surface}" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Surface}" FontSize="13" VerticalAlignment="Center" />
        <Button Content="{l:Tr Status_Undo}" Command="{Binding UndoStatusCommand}" IsVisible="{Binding HasStatusUndo}"
                Padding="8,2" Margin="6,-4,-8,-4" Background="Transparent" BorderThickness="0" FontWeight="SemiBold"
                Foreground="{DynamicResource Surface}" TextElement.FontWeight="Bold" />
      </StackPanel>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
