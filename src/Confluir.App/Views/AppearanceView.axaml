<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Confluir.App.ViewModels"
             xmlns:conv="using:Confluir.App.Converters"
             xmlns:res="using:Confluir.App.Resources"
             x:Class="Confluir.App.Views.AppearanceView"
             x:DataType="vm:AppearanceViewModel"
             Width="300">
  <UserControl.Styles>
    <Style Selector="RadioButton.themeOption">
      <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Margin="4">
    <TextBlock Text="{x:Static res:Strings.Appearance}" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimary}" />

    <StackPanel Spacing="6">
      <TextBlock Text="{x:Static res:Strings.Theme}" Classes="caption" />
      <UniformGrid Columns="3" ColumnSpacing="6">
        <RadioButton Classes="themeOption" GroupName="theme" IsChecked="{Binding IsLight}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Sun" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Theme_Light}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="theme" IsChecked="{Binding IsDark}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Moon" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Theme_Dark}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="theme" IsChecked="{Binding IsSystem}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Monitor" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Theme_System}" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="{x:Static res:Strings.AccentColor}" Classes="caption" />
      <ListBox Classes="swatches" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}"
               Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="2" LineSpacing="4" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:AccentOption">
            <Ellipse Width="24" Height="24" ToolTip.Tip="{Binding Name}"
                     Fill="{Binding SwatchHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ColorPicker Color="{Binding CustomColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" />
        <TextBlock Text="{x:Static res:Strings.Accent_Custom}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimary}" />
      </StackPanel>
    </StackPanel>

    <ToggleSwitch Content="{x:Static res:Strings.CompactMode}" IsChecked="{Binding CompactMode}"
                  OnContent="" OffContent="" />
  </StackPanel>
</UserControl>
