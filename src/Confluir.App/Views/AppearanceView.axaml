<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Confluir.App.Localization"
             xmlns:vm="using:Confluir.App.ViewModels"
             xmlns:conv="using:Confluir.App.Converters"
             x:Class="Confluir.App.Views.AppearanceView"
             x:DataType="vm:AppearanceViewModel"
             Width="300">
  <UserControl.Styles>
    <Style Selector="RadioButton.themeOption">
      <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="14" Margin="4,4,12,4">
    <TextBlock Text="{l:Tr Appearance}" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimary}" />

    <StackPanel Spacing="6">
      <TextBlock Text="{l:Tr Theme}" Classes="caption" />
      <UniformGrid Columns="3" ColumnSpacing="6">
        <RadioButton Classes="themeOption" GroupName="theme" IsChecked="{Binding IsLight}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Sun" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Theme_Light}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="theme" IsChecked="{Binding IsDark}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Moon" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Theme_Dark}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="theme" IsChecked="{Binding IsSystem}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Monitor" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Theme_System}" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="{l:Tr Layout}" Classes="caption" />
      <UniformGrid Columns="2" ColumnSpacing="6">
        <RadioButton Classes="themeOption" GroupName="layout" IsChecked="{Binding IsThreeColumns}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Columns3" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Layout_ThreeColumns}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="layout" IsChecked="{Binding IsTwoColumns}">
          <StackPanel Spacing="4">
            <LucideIcon Kind="Columns2" Size="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Layout_TwoColumns}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="{l:Tr AccentColor}" Classes="caption" />
      <ListBox Classes="swatches" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}"
               Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="2" LineSpacing="4" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:AccentOption">
            <Ellipse Width="24" Height="24"
                     Fill="{Binding SwatchHex, Converter={x:Static conv:HexToBrushConverter.Instance}}">
              <ToolTip.Tip>
                <MultiBinding Converter="{x:Static l:TrKeyConverter.Instance}">
                  <Binding Path="NameKey" />
                  <ReflectionBinding Path="Version" Source="{x:Static l:LocalizationService.Instance}" />
                </MultiBinding>
              </ToolTip.Tip>
            </Ellipse>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ColorPicker Color="{Binding CustomColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" />
        <TextBlock Text="{l:Tr Accent_Custom}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimary}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="{l:Tr Language}" Classes="caption" />
      <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="vm:LanguageOption">
            <TextBlock>
              <TextBlock.Text>
                <MultiBinding Converter="{x:Static l:TrKeyConverter.Instance}">
                  <Binding Path="LabelKey" />
                  <ReflectionBinding Path="Version" Source="{x:Static l:LocalizationService.Instance}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="{l:Tr ListTextSize}" Classes="caption" />
      <UniformGrid Columns="3" ColumnSpacing="6">
        <RadioButton Classes="themeOption" GroupName="listText" IsChecked="{Binding IsListTextSmall}">
          <StackPanel Spacing="2">
            <TextBlock Text="Aa" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr ListTextSize_Small}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="listText" IsChecked="{Binding IsListTextMedium}">
          <StackPanel Spacing="2">
            <TextBlock Text="Aa" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr ListTextSize_Medium}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="themeOption" GroupName="listText" IsChecked="{Binding IsListTextLarge}">
          <StackPanel Spacing="2">
            <TextBlock Text="Aa" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr ListTextSize_Large}" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </StackPanel>

    <ToggleSwitch Content="{l:Tr CompactMode}" IsChecked="{Binding CompactMode}"
                  OnContent="" OffContent="" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
