<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Confluir.App.ViewModels"
             xmlns:conv="using:Confluir.App.Converters"
             xmlns:res="using:Confluir.App.Resources"
             x:Class="Confluir.App.Views.AddAccountView"
             x:DataType="vm:AddAccountViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource Background}">
    <!-- Cabeçalho com voltar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1" Padding="12,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="icon" Command="{Binding CancelCommand}" ToolTip.Tip="{x:Static res:Strings.Action_Back}">
          <LucideIcon Kind="ArrowLeft" />
        </Button>
        <LucideIcon Kind="UserPlus" Size="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
        <TextBlock Text="{x:Static res:Strings.AddAccount_Title}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Ações -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <Grid ColumnDefinitions="Auto,*,Auto" MaxWidth="600">
        <Button Content="{x:Static res:Strings.AddAccount_Test}" Command="{Binding TestCommand}"
                IsEnabled="{Binding CanSubmit}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static res:Strings.AddAccount_Cancel}" Command="{Binding CancelCommand}" />
          <Button Classes="accent" Content="{x:Static res:Strings.AddAccount_Save}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding CanSubmit}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
              CornerRadius="12" Padding="28,24" Margin="24" MaxWidth="600">
        <StackPanel Spacing="14">

          <!-- Email + detecção -->
          <StackPanel>
            <TextBlock Classes="label" Text="{x:Static res:Strings.AddAccount_Email}" />
            <TextBox x:Name="EmailBox" Text="{Binding Email}" PlaceholderText="voce@exemplo.com" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding HasDetectionMessage}">
              <LucideIcon Kind="LoaderCircle" Size="14" Classes="spin" IsVisible="{Binding IsDetecting}"
                          Foreground="{DynamicResource TextSecondary}" />
              <LucideIcon Kind="Info" Size="14" IsVisible="{Binding !IsDetecting}" Foreground="{DynamicResource Accent}" />
              <TextBlock Text="{Binding DetectionMessage}" Classes="caption" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
          </StackPanel>

          <!-- Outlook: OAuth2 ainda não disponível -->
          <Border Classes="notice" IsVisible="{Binding RequiresOAuth}">
            <Grid ColumnDefinitions="Auto,*">
              <LucideIcon Kind="TriangleAlert" Size="18" Foreground="{DynamicResource Warning}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
                         Text="{x:Static res:Strings.AddAccount_OAuthRequired}" />
            </Grid>
          </Border>

          <StackPanel IsVisible="{Binding !RequiresOAuth}" Spacing="14">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static res:Strings.AddAccount_DisplayName}" />
              <TextBox Text="{Binding DisplayName}" PlaceholderText="{x:Static res:Strings.AddAccount_DisplayName_Placeholder}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="label" Text="{Binding PasswordLabel}" />
              <TextBox Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" />
              <!-- Ajuda de senha de app (Gmail/Yahoo) -->
              <Border Classes="notice" Margin="0,8,0,0" IsVisible="{Binding HasAppPasswordHint}">
                <Grid ColumnDefinitions="Auto,*">
                  <LucideIcon Kind="Info" Size="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                    <TextBlock Text="{Binding AppPasswordHint}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}" />
                    <HyperlinkButton Content="{x:Static res:Strings.AddAccount_AppPasswordLink}" Padding="0"
                                     Command="{Binding OpenAppPasswordHelpCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static res:Strings.AddAccount_Color}" />
              <ListBox Classes="swatches" ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor}"
                       Background="Transparent">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="2" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:AccountColorOption">
                    <Ellipse Width="24" Height="24" ToolTip.Tip="{Binding Name}"
                             Fill="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <!-- Configuração avançada -->
            <Expander Header="{x:Static res:Strings.AddAccount_Advanced}" IsExpanded="{Binding ShowAdvanced}"
                      HorizontalAlignment="Stretch">
              <StackPanel Spacing="14">
                <StackPanel>
                  <TextBlock Classes="label" Text="{x:Static res:Strings.AddAccount_UserName}" />
                  <TextBox Text="{Binding UserName}" />
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="{x:Static res:Strings.AddAccount_IncomingServer}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                  <Grid ColumnDefinitions="*,8,96,8,150">
                    <TextBox Text="{Binding ImapHost}" PlaceholderText="{x:Static res:Strings.AddAccount_Host}" />
                    <NumericUpDown Grid.Column="2" Value="{Binding ImapPort}" Minimum="1" Maximum="65535"
                                   Increment="1" FormatString="0" ShowButtonSpinner="False"
                                   ToolTip.Tip="{x:Static res:Strings.AddAccount_Port}" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding ImapSecurity}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="{x:Static res:Strings.AddAccount_Security}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SecurityOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="{x:Static res:Strings.AddAccount_OutgoingServer}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                  <Grid ColumnDefinitions="*,8,96,8,150">
                    <TextBox Text="{Binding SmtpHost}" PlaceholderText="{x:Static res:Strings.AddAccount_Host}" />
                    <NumericUpDown Grid.Column="2" Value="{Binding SmtpPort}" Minimum="1" Maximum="65535"
                                   Increment="1" FormatString="0" ShowButtonSpinner="False"
                                   ToolTip.Tip="{x:Static res:Strings.AddAccount_Port}" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding SmtpSecurity}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="{x:Static res:Strings.AddAccount_Security}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SecurityOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Expander>

            <!-- Resultado do teste -->
            <StackPanel>
              <ContentControl Content="{Binding ImapStatus}" />
              <ContentControl Content="{Binding SmtpStatus}" />
              <StackPanel.DataTemplates>
                <DataTemplate DataType="vm:TestStatusViewModel">
                  <Grid ColumnDefinitions="Auto,56,*" Margin="0,3" IsVisible="{Binding IsVisible}">
                    <Panel Width="18">
                      <LucideIcon Kind="LoaderCircle" Size="16" Classes="spin" IsVisible="{Binding IsTesting}"
                                  Foreground="{DynamicResource TextSecondary}" />
                      <LucideIcon Kind="CircleCheck" Size="16" IsVisible="{Binding IsOk}" Foreground="{DynamicResource Success}" />
                      <LucideIcon Kind="CircleX" Size="16" IsVisible="{Binding IsFailed}" Foreground="{DynamicResource Danger}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Protocol}" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                  </Grid>
                </DataTemplate>
              </StackPanel.DataTemplates>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Danger}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
