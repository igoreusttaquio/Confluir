<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Confluir.App.Localization"
             xmlns:vm="using:Confluir.App.ViewModels"
             xmlns:views="using:Confluir.App.Views"
             xmlns:conv="using:Confluir.App.Converters"
             x:Class="Confluir.App.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Button.accountHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,12,10,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accountHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.accountHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="LucideIcon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="LucideIcon.chevron.collapsed">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <!-- Troca entre barra completa e faixa recolhida -->
    <Style Selector="Panel.sidebarRoot > DockPanel">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.sidebarRoot > DockPanel.rail">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.sidebarRoot.collapsed > DockPanel.rail">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Panel.sidebarRoot.collapsed > DockPanel.full">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Contador sobre o ícone na barra recolhida -->
    <Style Selector="Border.railBadge">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-9,-12,0" />
    </Style>
    <Style Selector="Border.railBadge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- Cartão como os demais, com o mesmo respiro de 8px também na borda esquerda da janela -->
  <Border Classes="panel" Background="{DynamicResource SurfaceAlt}" ClipToBounds="True" Margin="8,8,8,8">
    <!-- As duas versões ficam sobrepostas e trocam por esmaecimento enquanto a coluna anima a largura. -->
    <Panel Classes="sidebarRoot" Classes.collapsed="{Binding IsSidebarCollapsed}">
    <!-- Barra recolhida: faixa de ícones (caixa unificada, uma bolinha por conta e o rodapé). -->
    <DockPanel Classes="rail" Width="64" HorizontalAlignment="Left">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,14,0,8" HorizontalAlignment="Center">
        <Button Classes="icon" Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Center"
                ToolTip.Tip="{l:Tr Action_ExpandSidebar}" AutomationProperties.Name="{l:Tr Action_ExpandSidebar}">
          <LucideIcon Kind="Menu" />
        </Button>
        <Border Height="1" Margin="8,6" Background="{DynamicResource Border}" />
        <Button Classes="icon" Command="{Binding SelectUnifiedCommand}" HorizontalAlignment="Center"
                ToolTip.Tip="{l:Tr UnifiedInbox}" AutomationProperties.Name="{l:Tr UnifiedInbox}">
          <Panel>
            <LucideIcon Kind="Mails" Foreground="{DynamicResource Accent}" />
            <Border Classes="railBadge" IsVisible="{Binding UnifiedInbox.HasUnread}">
              <TextBlock Text="{Binding UnifiedInbox.UnreadCount, StringFormat={}{0:N0}}" />
            </Border>
          </Panel>
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,6,0,10" HorizontalAlignment="Center">
        <Button Classes="icon" ToolTip.Tip="{l:Tr Account_Add}" AutomationProperties.Name="{l:Tr Account_Add}" Command="{Binding AddAccountCommand}">
          <LucideIcon Kind="UserPlus" />
        </Button>
        <Button Classes="icon" ToolTip.Tip="{l:Tr Appearance}" AutomationProperties.Name="{l:Tr Appearance}">
          <LucideIcon Kind="Palette" />
          <Button.Flyout>
            <Flyout Placement="RightEdgeAlignedBottom">
              <ScrollViewer MaxHeight="620" Width="312" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Margin="4,4,12,4"><TextBlock Text="{l:Tr Appearance}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /><views:AppearanceView DataContext="{Binding Appearance}" /></StackPanel></ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="icon" ToolTip.Tip="{l:Tr Settings}" AutomationProperties.Name="{l:Tr Settings}" Command="{Binding OpenSettingsCommand}">
          <LucideIcon Kind="Settings" />
        </Button>
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <ItemsControl ItemsSource="{Binding AccountNodes}" HorizontalAlignment="Center">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:AccountNode">
              <Button Classes="icon" Margin="0,3" Padding="4" ToolTip.Tip="{Binding Account.DisplayName}"
                      AutomationProperties.Name="{Binding Account.DisplayName}"
                      Command="{Binding $parent[views:SidebarView].((vm:MainWindowViewModel)DataContext).SelectAccountInboxCommand}"
                      CommandParameter="{Binding}">
                <Border Width="30" Height="30" CornerRadius="15"
                        Background="{Binding Account.ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}">
                  <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource OnAccountColor}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Largura mínima fixa: ao recolher, o conteúdo é cortado (não espremido) enquanto a coluna diminui. -->
    <DockPanel Classes="full" MinWidth="200">
      <!-- Menu (recolher) no mesmo lugar do botão da faixa recolhida, e a marca -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="15,14,10,10">
        <Button Classes="icon" Command="{Binding ToggleSidebarCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{l:Tr Action_CollapseSidebar}" AutomationProperties.Name="{l:Tr Action_CollapseSidebar}">
          <LucideIcon Kind="Menu" />
        </Button>
        <Image Grid.Column="1" Source="{StaticResource LogoImage}" Width="26" Height="26" Margin="8,0,0,0" />
        <TextBlock Grid.Column="2" Text="{l:Tr AppTitle}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
      </Grid>

      <!-- Rodapé: aparência e configurações -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="icon" ToolTip.Tip="{l:Tr Account_Add}" AutomationProperties.Name="{l:Tr Account_Add}" Command="{Binding AddAccountCommand}">
            <LucideIcon Kind="UserPlus" />
          </Button>
          <Button Classes="icon" ToolTip.Tip="{l:Tr Appearance}" AutomationProperties.Name="{l:Tr Appearance}">
            <LucideIcon Kind="Palette" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <ScrollViewer MaxHeight="620" Width="312" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Margin="4,4,12,4"><TextBlock Text="{l:Tr Appearance}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /><views:AppearanceView DataContext="{Binding Appearance}" /></StackPanel></ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon" ToolTip.Tip="{l:Tr Settings}" AutomationProperties.Name="{l:Tr Settings}" Command="{Binding OpenSettingsCommand}">
            <LucideIcon Kind="Settings" />
          </Button>
        </StackPanel>
      </Border>

      <ListBox ItemsSource="{Binding SidebarNodes}"
               SelectedItem="{Binding SelectedNode}"
               ItemContainerTheme="{StaticResource SidebarItemTheme}"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:UnifiedInboxNode">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8">
              <LucideIcon Kind="Mails" Size="18" StrokeWidth="1.75" Foreground="{DynamicResource Accent}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" FontWeight="SemiBold" FontSize="{DynamicResource SidebarItemFontSize}"
                         Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                <TextBlock Text="{Binding UnreadCount, StringFormat={}{0:N0}}" />
              </Border>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="vm:AccountNode">
            <StackPanel>
              <Button Classes="accountHeader" Command="{Binding ToggleCommand}"
                      ToolTip.Tip="{l:Tr Action_Collapse}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{l:Tr Account_Edit}" Command="{Binding EditCommand}">
                      <MenuItem.Icon>
                        <LucideIcon Kind="Settings" Size="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Tr Account_Remove}" Command="{Binding AskRemoveCommand}">
                      <MenuItem.Icon>
                        <LucideIcon Kind="Trash" Size="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                  <LucideIcon Classes="chevron" Classes.collapsed="{Binding !IsExpanded}"
                              Kind="ChevronDown" Size="14" Foreground="{DynamicResource TextSecondary}" />
                  <Ellipse Grid.Column="1" Width="9" Height="9" Margin="8,0"
                           Fill="{Binding Account.ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource SidebarAccountFontSize}"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Account.Email}" Classes="caption" FontSize="{DynamicResource SidebarCaptionFontSize}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Panel Grid.Column="3">
                    <LucideIcon Kind="LoaderCircle" Size="14" Classes="spin" IsVisible="{Binding IsLoading}"
                                Foreground="{DynamicResource TextSecondary}"
                                ToolTip.Tip="{l:Tr Account_Syncing}" />
                    <LucideIcon Kind="CloudOff" Size="14" IsVisible="{Binding IsOffline}"
                                Foreground="{DynamicResource TextSecondary}"
                                ToolTip.Tip="{l:Tr Account_Offline}" />
                  </Panel>
                </Grid>
              </Button>
              <!-- Confirmação de remoção (inline, sem diálogo) -->
              <Border Margin="10,0,10,8" Padding="10" CornerRadius="8" Background="{DynamicResource Surface}"
                      BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                      IsVisible="{Binding IsConfirmingRemoval}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{l:Tr Account_Remove_Confirm}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource TextPrimary}" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Content="{l:Tr AddAccount_Cancel}" Command="{Binding CancelRemoveCommand}"
                            Padding="10,4" FontSize="12" />
                    <Button Classes="danger" Content="{l:Tr Account_Remove}"
                            Command="{Binding ConfirmRemoveCommand}" Padding="10,4" FontSize="12" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- Falha ao carregar pastas -->
              <Grid ColumnDefinitions="Auto,*" Margin="32,0,10,6" IsVisible="{Binding HasError}">
                <LucideIcon Kind="CircleAlert" Size="14" Foreground="{DynamicResource Danger}" VerticalAlignment="Top"
                            Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Error}" Classes="caption" TextWrapping="Wrap" />
                  <HyperlinkButton Content="{l:Tr Action_Retry}" Command="{Binding RetryCommand}"
                                   Padding="0" FontSize="12" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="vm:FolderNode">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="32,6,10,6">
              <LucideIcon Kind="{Binding Icon}" Size="16" StrokeWidth="1.75" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource SidebarItemFontSize}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                <TextBlock Text="{Binding UnreadCount, StringFormat={}{0:N0}}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </DockPanel>
    </Panel>
  </Border>
</UserControl>
