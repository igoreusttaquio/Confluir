<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Confluir.App.Localization"
             xmlns:vm="using:Confluir.App.ViewModels"
             xmlns:views="using:Confluir.App.Views"
             xmlns:conv="using:Confluir.App.Converters"
             x:Class="Confluir.App.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Button.accountHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,12,10,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accountHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.accountHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="LucideIcon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="LucideIcon.chevron.collapsed">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
  </UserControl.Styles>

  <Border Classes="panel" Background="{DynamicResource SurfaceAlt}">
    <DockPanel>
      <!-- Marca -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="18,16,18,12">
        <Image Source="{StaticResource LogoImage}" Width="28" Height="28" />
        <TextBlock Text="{l:Tr AppTitle}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Rodapé: aparência e configurações -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="icon" ToolTip.Tip="{l:Tr Account_Add}" Command="{Binding AddAccountCommand}">
            <LucideIcon Kind="UserPlus" />
          </Button>
          <Button Classes="icon" ToolTip.Tip="{l:Tr Appearance}">
            <LucideIcon Kind="Palette" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <views:AppearanceView DataContext="{Binding Appearance}" />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon" ToolTip.Tip="{l:Tr Settings}" IsEnabled="False">
            <LucideIcon Kind="Settings" />
          </Button>
        </StackPanel>
      </Border>

      <ListBox ItemsSource="{Binding SidebarNodes}"
               SelectedItem="{Binding SelectedNode}"
               ItemContainerTheme="{StaticResource SidebarItemTheme}"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:UnifiedInboxNode">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,8">
              <LucideIcon Kind="Mails" Size="18" StrokeWidth="1.75" Foreground="{DynamicResource Accent}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                <TextBlock Text="{Binding UnreadCount, StringFormat={}{0:N0}}" />
              </Border>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="vm:AccountNode">
            <StackPanel>
              <Button Classes="accountHeader" Command="{Binding ToggleCommand}"
                      ToolTip.Tip="{l:Tr Action_Collapse}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{l:Tr Account_Edit}" Command="{Binding EditCommand}">
                      <MenuItem.Icon>
                        <LucideIcon Kind="Settings" Size="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{l:Tr Account_Remove}" Command="{Binding AskRemoveCommand}">
                      <MenuItem.Icon>
                        <LucideIcon Kind="Trash" Size="16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                  <LucideIcon Classes="chevron" Classes.collapsed="{Binding !IsExpanded}"
                              Kind="ChevronDown" Size="14" Foreground="{DynamicResource TextSecondary}" />
                  <Ellipse Grid.Column="1" Width="9" Height="9" Margin="8,0"
                           Fill="{Binding Account.ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Account.Email}" Classes="caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Panel Grid.Column="3">
                    <LucideIcon Kind="LoaderCircle" Size="14" Classes="spin" IsVisible="{Binding IsLoading}"
                                Foreground="{DynamicResource TextSecondary}"
                                ToolTip.Tip="{l:Tr Account_Syncing}" />
                    <LucideIcon Kind="CloudOff" Size="14" IsVisible="{Binding IsOffline}"
                                Foreground="{DynamicResource TextSecondary}"
                                ToolTip.Tip="{l:Tr Account_Offline}" />
                  </Panel>
                </Grid>
              </Button>
              <!-- Confirmação de remoção (inline, sem diálogo) -->
              <Border Margin="10,0,10,8" Padding="10" CornerRadius="8" Background="{DynamicResource Surface}"
                      BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                      IsVisible="{Binding IsConfirmingRemoval}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{l:Tr Account_Remove_Confirm}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource TextPrimary}" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Content="{l:Tr AddAccount_Cancel}" Command="{Binding CancelRemoveCommand}"
                            Padding="10,4" FontSize="12" />
                    <Button Classes="danger" Content="{l:Tr Account_Remove}"
                            Command="{Binding ConfirmRemoveCommand}" Padding="10,4" FontSize="12" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- Falha ao carregar pastas -->
              <Grid ColumnDefinitions="Auto,*" Margin="32,0,10,6" IsVisible="{Binding HasError}">
                <LucideIcon Kind="CircleAlert" Size="14" Foreground="{DynamicResource Danger}" VerticalAlignment="Top"
                            Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Error}" Classes="caption" TextWrapping="Wrap" />
                  <HyperlinkButton Content="{l:Tr Action_Retry}" Command="{Binding RetryCommand}"
                                   Padding="0" FontSize="12" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="vm:FolderNode">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="32,6,10,6">
              <LucideIcon Kind="{Binding Icon}" Size="16" StrokeWidth="1.75" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" Foreground="{DynamicResource TextPrimary}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                <TextBlock Text="{Binding UnreadCount, StringFormat={}{0:N0}}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
